# Deny by default; only the backend and locked dependencies enter the image.
**
!Dockerfile
!.dockerignore
!server/
!server/**
**/.env
**/.env.*
**/__pycache__/**
**/*.pyc
**/*.db
**/*.db-*
**/*.sqlite*
**/backups/**
**/logs/**
**/*.log
server/test*
server/conftest.py
server/fixtures/**
server/collector/qa_harness.py
server/requirements-dev.txt
**/node_modules/**
**/.git/**
**/artifacts/**
**/secrets.*
**/credentials.*
**/*.key
**/*.pem
