+"""Real local HTTP/TLS, synthetic payloads, ephemeral test CA only."""
+import asyncio
+from contextlib import contextmanager
+import sqlite3
+import httpx
+import pytest
+from server.cloud_sync.wechat_dispatch_authority import DispatchAuthority, DispatchDenied, Grant, locked_source
+from server.cloud_sync.wechat_dispatch_transport import DispatchTransport
+from server.cloud_sync.wechat_prepared_connection import PreparedBackend
+from server.tests_wechat.test_loopback_dispatch_lease_experiment import synthetic, tls_contexts, server_fixture
+
+
+@pytest.mark.parametrize('tls', [False,True])
+@pytest.mark.parametrize('mode', ['ok','revoke','changed','cancel_after'])
+def test_real_handoff_order(synthetic,tls_contexts,tls,mode):
+    async def scenario():
+        server_ssl,ca,_,_=tls_contexts
+        server,url,received,respond,bodies=await server_fixture(server_ssl=server_ssl if tls else None)
+        origin=str(httpx.URL(url).copy_with(path='/'))
+        backend=PreparedBackend(origin,ca_pem=ca.decode() if tls else None,loopback_http=not tls)
+        authority=DispatchAuthority(synthetic['database'].parent/'authority.sqlite',clock=lambda:10)
+        authority.initialize();grant=Grant('g','a'*64,20,False)
+        authority.import_verified(grant,lambda value:value==grant)
+        payload=b'{"synthetic":"notice"}'
+        @contextmanager
+        def snapshot():
+            with locked_source(synthetic['database'],lambda db: payload if db.execute('SELECT eligible FROM evidence').fetchone()[0] else b'changed') as body:
+                yield body
+        original=backend.prepare
+        async def prepare(destination):
+            connection=await original(destination)
+            if mode=='revoke':authority.revoke('g')
+            if mode=='changed':
+                with sqlite3.connect(synthetic['database']) as db:db.execute('UPDATE evidence SET eligible=0')
+            return connection
+        backend.prepare=prepare
+        transport=DispatchTransport(backend)
+        try:
+            async with httpx.AsyncClient(transport=transport,trust_env=False) as client:
+                task=asyncio.create_task(transport.post(client,url,authority=authority,identity='g',binding='a'*64,
+                    snapshot=snapshot,validate=lambda:True,content=payload,headers={'Content-Type':'application/json'}))
+                if mode in {'revoke','changed'}:
+                    with pytest.raises(DispatchDenied):await task
+                    assert bodies==[]
+                else:
+                    await asyncio.wait_for(received.wait(),2)
+                    # Server received the authorized bytes. While it withholds
+                    # its response, independent writes/revocation must complete.
+                    authority.revoke('g')
+                    with sqlite3.connect(synthetic['database'],timeout=.1) as db:
+                        db.execute('UPDATE evidence SET eligible=0')
+                    if mode=='cancel_after':
+                        task.cancel()
+                        with pytest.raises(asyncio.CancelledError):await task
+                    else:
+                        respond.set()
+                        assert (await task).status_code==200
+                    assert bodies==[payload]
+        finally:
+            respond.set();server.close();await server.wait_closed()
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize('fault', ['untrusted','hostname'])
+def test_bad_tls_sends_no_application_request(synthetic,tls_contexts,fault):
+    async def scenario():
+        server_ssl,ca,wrong_host,other_ca=tls_contexts
+        server,url,_,respond,bodies=await server_fixture(server_ssl=wrong_host if fault=='hostname' else server_ssl)
+        backend=PreparedBackend(str(httpx.URL(url).copy_with(path='/')),
+            ca_pem=(other_ca if fault=='untrusted' else ca).decode())
