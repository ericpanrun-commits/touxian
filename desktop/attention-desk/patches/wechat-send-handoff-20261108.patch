+"""Frozen file and SQLite inputs for the existing incremental recovery builder.
+
+Only explicitly persisted context is accepted. Missing files fail closed; this
+does not create a profile, change Collector, or enable any sender.
+"""
+from contextlib import ExitStack, contextmanager
+import json
+import os
+from pathlib import Path
+import time
+
+import yaml
+
+from ..user_context import UserContext
+from ..wechat_collect.config import SettingsDocument
+from .wechat_dispatch_authority import DispatchDenied, locked_source
+from .wechat_file_lease import immutable_evidence
+from .wechat_incremental_preview import preview, prepare_scope, instant
+from .wechat_incremental_recovery import _ReadSnapshotStore
+
+
+class FrozenRecoverySnapshot:
+    def __init__(self, recovery):
+        self.recovery = recovery
+
+    @contextmanager
+    def __call__(self, consent, meta):
+        recovery = self.recovery
+        directory = recovery.personal.path.parent
+        worker_path = Path(recovery.sender.settings.path).resolve()
+        control_path = Path(os.environ.get('ATTENTION_RECOVERY_CONTROL_PATH')
+                            or directory / 'recovery-controls.json').resolve()
+        with ExitStack() as stack:
+            # These leases deny both direct writes and atomic file replacement,
+            # including writers that do not participate in Python-level locks.
+            document_bytes = stack.enter_context(immutable_evidence((directory/'wechat.yaml').resolve(), max_bytes=65536))
+            context_bytes = stack.enter_context(immutable_evidence((directory/'user-context.json').resolve(), max_bytes=65536))
+            stack.enter_context(immutable_evidence(worker_path))
+            control_bytes = stack.enter_context(immutable_evidence(control_path))
+            document = SettingsDocument.model_validate(yaml.safe_load(document_bytes))
+            context = UserContext.model_validate_json(context_bytes).model_dump()
+            controls = json.loads(control_bytes)
+            if (controls.get('version') != 1 or controls.get('hold_cloud_uploads') is not True
+                    or controls.get('pause_paid_ai') is not True):
+                raise DispatchDenied('controls_changed')
+            # The cached document may lag a disk update; don't use stale cache
+            # or modify it while protecting a send. Build from leased bytes.
+            if recovery.document_read() != document or recovery.context_read() != context:
+                raise DispatchDenied('context_cache_changed')
+            deadline = time.monotonic() + 0.5
+
+            def build(connection):
+                connection.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
+                scope = prepare_scope(connection, document, not_before=consent.scope.not_before,
+                                      phase_chat_ids=consent.scope.phase_chat_ids, context=context)
+                if scope != consent.scope:
+                    raise DispatchDenied('scope_changed')
+                if meta is None:
+                    return None  # metadata reconciliation does not resend text
+                result = preview(connection, document, scope, now=instant(recovery.clock()), context=context,
+                                 tracked=recovery.journal.tracked_messages())
+                matches = [row for row in result['selections'] if row['raw_item_id'] == meta['raw_id']]
+                if len(matches) != 1:
+                    raise DispatchDenied('content_changed')
+                return recovery._bundle(matches[0], scope, _ReadSnapshotStore(connection), document)
+
+            with locked_source(recovery.personal.path, build) as bundle:
+                if time.monotonic() >= deadline:
+                    raise DispatchDenied('snapshot_deadline')
+                yield bundle
