+"""Synthetic transport wiring; never accepts a real network backend."""
+from contextlib import contextmanager
+import httpx
+import json
+import sqlite3
+from collections.abc import MutableMapping
+from types import SimpleNamespace
+from server.cloud_sync.wechat_dispatch_authority import DispatchAuthority, Grant, locked_source
+from server.cloud_sync.wechat_dispatch_transport import DispatchTransport
+
+class MockConnection:
+    def __init__(self, transport): self.transport=transport
+    def accept(self, request): self.result=self.transport.handle_request(request)
+    async def response(self): return self.result
+    async def aclose(self): pass
+
+class MockBackend:
+    def __init__(self, transport):
+        assert type(transport) is httpx.MockTransport
+        self.transport=transport
+    async def prepare(self, url): return MockConnection(self.transport)
+    async def aclose(self): pass
+
+
+def install(sender, consent, *, personal=None):
+    authority=DispatchAuthority(sender.journal.path.parent/'dispatch-authority.sqlite',
+        clock=lambda:sender.clock().timestamp())
+    authority.initialize()
+    descriptor=Grant(consent.approval_id,consent.scope_id(),consent.expires_at.timestamp(),False)
+    authority.import_verified(descriptor,lambda value:value==descriptor)
+    sender.dispatch_authority=authority
+    sender.dispatch_transport=DispatchTransport(MockBackend(sender.client._transport))
+    sender.client._transport=sender.dispatch_transport
+    @contextmanager
+    def snapshot(approval, meta):
+        def build(_=None):
+            return sender.rebuild(approval.scope,meta['raw_id']) if meta is not None else None
+        if personal is None:
+            yield build()
+        else:
+            with locked_source(personal.path,build) as bundle: yield bundle
+    sender.dispatch_snapshot=snapshot
+    return authority
+
+
+class PersistentMap(MutableMapping):
+    """Fixture state with real SQLite writer exclusion, not a cooperating lock."""
+    def __init__(self,path,name,initial):
+        self.path,self.name=path,name
+        with sqlite3.connect(path) as db:
+            db.execute('CREATE TABLE IF NOT EXISTS synthetic_dispatch_state(name TEXT PRIMARY KEY, value TEXT)')
+            db.execute('INSERT INTO synthetic_dispatch_state VALUES (?,?)',(name,json.dumps(initial)))
+    def _read(self):
+        with sqlite3.connect(self.path) as db:
+            return json.loads(db.execute('SELECT value FROM synthetic_dispatch_state WHERE name=?',(self.name,)).fetchone()[0])
+    def __getitem__(self,key):return self._read()[str(key)]
+    def __iter__(self):return iter(self._read())
+    def __len__(self):return len(self._read())
+    def __setitem__(self,key,value):
+        with sqlite3.connect(self.path,timeout=0.1) as db:
+            db.execute('BEGIN IMMEDIATE')
+            current=json.loads(db.execute('SELECT value FROM synthetic_dispatch_state WHERE name=?',(self.name,)).fetchone()[0])
+            current[str(key)]=value
+            db.execute('UPDATE synthetic_dispatch_state SET value=? WHERE name=?',(json.dumps(current),self.name))
+    def __delitem__(self,key):raise NotImplementedError
+
+
+def issue(sender, consent):
+    # Explicit synthetic independent approval for a new identity/binding.
+    if hasattr(consent,'grant_id'):
+        descriptor=Grant(consent.grant_id,consent.approval_binding(),consent.expires_at.timestamp(),True)
+    else:
+        descriptor=Grant(consent.approval_id,consent.scope_id(),consent.expires_at.timestamp(),False)
+    sender.dispatch_authority.import_verified(descriptor,lambda value:value==descriptor)
+
+
+def changed_consent(sender, consent, **changes):
+    from dataclasses import replace
+    from uuid import uuid4
+    updated=replace(consent,approval_id=str(uuid4()),**changes)
+    issue(sender,updated)
+    return updated
