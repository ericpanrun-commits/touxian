+        assert rig.guard.request_revocation(rig.consent.approval_id)['state']=='revocation_requested'
+        return await original(url)
+    backend.prepare=prepare
+    assert rig.send()['state']=='grant_not_current'
+    assert rig.state['calls']==0
+
+
+def test_content_changes_while_connecting_are_not_sent(rig):
