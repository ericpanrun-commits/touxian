+        rig.current[0]=None
+        return await original(url)
+    backend.prepare=prepare
+    assert rig.send()['state']=='content_changed'
+    assert rig.state['calls']==0
+
+
+def test_actual_handoff_holds_content_settings_and_grant(rig):
+    backend=rig.sender.dispatch_transport.backend
+    original=backend.prepare
+    async def prepare(url):
+        connection=await original(url)
+        accept=connection.accept
