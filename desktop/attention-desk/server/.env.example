# Copy to server/.env. Never commit server/.env or a real device key.
APP_ENV=development
APP_RUNTIME=desktop
INSTANCE_ID=local-desktop
AUTO_SYNC_ENABLED=false
PRODUCTION_NOTIFICATION_AUTHORITY=false
CLOUD_BOOTSTRAP_MODE=false
NOTIFICATION_DRY_RUN=false
# Explicit true allows the local test button; automatic Bark still requires verified cloud authority.
BARK_ENABLED=false
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=your_bark_device_key_here
BARK_GROUP=ZQU
BARK_DEFAULT_SOUND=
# Optional override: a complete Bark push URL, kept only in server/.env.
# BARK_PUSH_URL=
